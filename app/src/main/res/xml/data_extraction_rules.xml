<?xml version="1.0" encoding="utf-8"?>
<!-- Signatures and pairings stay off Google's cloud backup; moving to a new
     device directly takes them along (the new device then pairs again, its
     key never leaves the old one's keystore). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
